{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt-on-edit.ps1\"",
            "statusMessage": "rustfmt"
          }
        ]
      }
    ]
  }
}
