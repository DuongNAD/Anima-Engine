{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt-on-edit.mjs\"",
            "statusMessage": "rustfmt"
          }
        ]
      }
    ]
  }
}
