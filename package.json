{
  "name": "anima-engine-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features desktop",
    "tauri:build": "tauri build --features desktop",
    "test": "vitest run",
    "test:frontend": "vitest run --config vitest.config.ts --root tests",
    "test:e2e": "npm run test:e2e --prefix tests",
    "test:all": "npm run test && npm run test:frontend && npm run test:e2e",
    "gen:manifest": "node scripts/run_ts.mjs scripts/gen_map_manifest.ts",
    "lint": "eslint .",
    "check:csp": "node scripts/check_csp_compat.mjs",
    "gen:world-manifest": "node scripts/run_ts.mjs scripts/gen_world_manifest.ts",
    "gen:artifact-fixture": "node scripts/run_ts.mjs scripts/gen_artifact_fixture.ts",
    "check:bundle": "node scripts/check_bundle_budget.mjs",
    "check:notice": "node scripts/gen_notice.mjs --check",
    "check:flora-footprint": "node scripts/check_flora_footprint.mjs",
    "capture:views": "npm run capture:views --prefix tests",
    "gen:sbom": "node scripts/gen_sbom.mjs",
    "check:sbom": "node scripts/gen_sbom.mjs --check",
    "gen:map-evidence": "node scripts/run_ts.mjs scripts/gen_map_evidence.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.61.0",
    "@react-three/fiber": "^8.13.0",
    "@tauri-apps/api": "^2.0.0",
    "@types/three": "^0.184.1",
    "pixi.js": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
