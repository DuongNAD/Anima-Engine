{
  "name": "anima-engine-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:frontend": "vitest run --config vitest.config.ts --root tests",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml --offline",
    "cargo:build": "cargo build --manifest-path src-tauri/Cargo.toml --offline",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml --offline",
    "tauri:icon": "tauri icon src-tauri/source-icon.png"
  },
  "dependencies": {
    "@react-three/fiber": "^8.13.0",
    "@tauri-apps/api": "^2.0.0",
    "@types/three": "^0.184.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "pixi.js": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.0",
    "typescript": "^5.2.2",
