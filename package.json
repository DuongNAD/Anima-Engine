{
  "name": "anima-engine-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features desktop",
    "tauri:build": "tauri build --features desktop",
    "test": "vitest run",
    "test:frontend": "vitest run --config vitest.config.ts --root tests",
    "test:e2e": "npm run test:e2e --prefix tests",
    "test:all": "npm run test && npm run test:frontend && npm run test:e2e",
    "gen:manifest": "esbuild scripts/gen_map_manifest.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/gen_map_manifest.cjs && node node_modules/.cache/gen_map_manifest.cjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@playwright/test": "^1.61.0",
    "@react-three/fiber": "^8.13.0",
    "@tauri-apps/api": "^2.0.0",
    "@types/three": "^0.184.1",
    "pixi.js": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
