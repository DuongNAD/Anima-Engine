      "smoke/"
    ]
  },
  "commands": {
    "build_release": "cargo build --manifest-path src-tauri/Cargo.toml --release --features desktop --example run_sel2p_experiment",
    "pipeline_check": "src-tauri/target/release/examples/run_sel2p_experiment --pipeline-check --manifest-dir src-tauri/tests/fixtures/experiments_sel2p --out /tmp/sel2p-pipeline-check",
    "smoke": "src-tauri/target/release/examples/run_sel2p_experiment --smoke --manifest-dir src-tauri/tests/fixtures/experiments_sel2p --out artifacts/experiments/sel2-p-food-scarcity",
